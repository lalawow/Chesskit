// Cloudflare Workers deployment of the static export (out/).
// Build with `pnpm build:cloudflare`, then deploy with `pnpm deploy:cloudflare`.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chesskit",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
